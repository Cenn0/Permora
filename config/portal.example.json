{
  "ConnectionStrings": {
    "Portal": "Host=postgres.internal;Database=permora;Username=permora_app;Password=REPLACE_LOCALLY"
  },
  "Portal": {
    "Authority": "https://sso.example.org/realms/enterprise",
    "ClientId": "permora-portal",
    "ClientSecretFile": "/run/secrets/portal-client",
    "PublicOrigin": "https://access.example.org",
    "DataProtectionPath": "/var/lib/permora/keys",
    "AdministratorSubjects": [
      "REPLACE_WITH_KEYCLOAK_SUB"
    ],
    "RealmTeams": {
      "enterprise": [
        "10000000-0000-4000-8000-000000000001"
      ]
    },
    "EnableDevelopmentLogin": false,
    "AllowHttpInDevelopment": false,
    "PrivilegedAcr": "2",
    "PrivilegedAuthenticationMaxAgeMinutes": 10
  },
  "Keycloak": {
    "AllowHttpInDevelopment": false,
    "Realms": {
      "enterprise": {
        "BaseUrl": "https://sso-admin.example.org",
        "Realm": "enterprise",
        "Issuer": "https://sso.example.org/realms/enterprise",
        "Roles": {
          "ClientId": "permora-role-editor",
          "SecretFile": "/run/secrets/role-editor"
        },
        "Assignments": {
          "ClientId": "permora-role-mapper",
          "SecretFile": "/run/secrets/role-mapper"
        },
        "Directory": {
          "ClientId": "permora-directory-reader",
          "SecretFile": "/run/secrets/directory-reader"
        },
        "ProtectedSubjectIds": []
      }
    }
  }
}
